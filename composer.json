{
  "name": "fainohub/hyperf-opentelemetry",
  "description": "OpenTelemetry component for Hyperf Framework",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Thiago Faino",
      "email": "thiagofaino@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-redis": "*",
    "hyperf/command": "~3.1.0",
    "hyperf/crontab": "~3.1.0",
    "hyperf/database": "~3.1.0",
    "hyperf/di": "~3.1.0",
    "hyperf/event": "~3.1.0",
    "hyperf/guzzle": "~3.1.0",
    "hyperf/http-server": "~3.1.0",
    "hyperf/redis": "~3.1.0",
    "open-telemetry/api": "^1.1",
    "open-telemetry/context-swoole": "^1.0",
    "open-telemetry/exporter-otlp": "^1.1",
    "open-telemetry/sdk": "^1.1",
    "open-telemetry/sem-conv": "^1.27"
  },
  "autoload" : {
    "psr-4" : {
      "FainoHub\\Hyperf\\OpenTelemetry\\" :  "src/"
    }
  },
  "extra": {
    "hyperf": {
      "config": "FainoHub\\Hyperf\\OpenTelemetry\\ConfigProvider"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false,
      "tbachert/spi": false
    }
  }
}